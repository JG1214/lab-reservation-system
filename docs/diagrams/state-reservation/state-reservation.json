  "cards": [
    {
      "dot": "cyan",
      "title": "四态状态机",
      "items": [
        "reservation.status 只有 0/1/2/3 四个取值，对应 Constants.RES_STATUS_*",
        "待审核(0) 是唯一入口，提交预约即写入该状态",
        "已通过(1) 之后的使用结果记在 usage_record，不扩充预约状态"
      ]
    },
    {
      "dot": "amber",
      "title": "审核闸门（仅管理员）",
      "items": [
        "仅待审核(0)可审核，通过/驳回二选一",
        "通过前在教室行 FOR UPDATE 锁内复查时段冲突与人数容量",
        "驳回必须填写审核备注，通过不写备注"
      ]
    },
    {
      "dot": "violet",
      "title": "用户取消约束",
      "items": [
        "只能取消本人的预约，且仅待审核(0)/已通过(1)可取消",
        "预约开始前 1 小时内禁止取消",
        "必须填写取消原因并记录取消时间；已登记的使用记录级联删除"
      ]
    },
    {
      "dot": "rose",
      "title": "终态与并发保护",
      "items": [
        "已驳回(2)、已取消(3) 没有出边，不可再流转",
        "状态写入均为条件更新（WHERE status = 期望值）+ 影响行数校验",
        "并发下取消与审核互踩时，后写者不会覆盖先写结果"
      ]
    }
  ]
}