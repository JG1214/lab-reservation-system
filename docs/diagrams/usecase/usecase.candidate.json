  "cards": [
    {
      "dot": "cyan",
      "title": "参与者与角色",
      "items": [
        "学生 role=0 与教师 role=2 共用 /student 路由（学生端 6 页）",
        "实验室管理员与系统管理员同为 role=1，共用 /admin 路由（管理端 8 页）",
        "内置账号 admin 显示名为「系统管理员」；图中按职责划分，不改变权限口径"
      ]
    },
    {
      "dot": "amber",
      "title": "预约核心规则",
      "items": [
        "冲突检测公式：新开始 < 旧结束 AND 新结束 > 旧开始，仅与已通过(1)预约比较",
        "预约必须完整落在 lab_open_slot 开放时段内，单时段人数不超过 slot_capacity",
        "前端实时校验（/api/reservation/conflict）+ 后端二次校验"
      ]
    },
    {
      "dot": "emerald",
      "title": "状态流转",
      "items": [
        "待审核(0) → 已通过(1) / 已驳回(2)；待审核或已通过 → 已取消(3)",
        "审核仅限待审核记录，驳回必填审核备注"
      ]
    },
    {
      "dot": "violet",
      "title": "AI 能力边界",
      "items": [
        "agnes-3.0-flash（国内节点），超时 60s，失败降级本地规则模拟",
        "双开关：application.yml ai.enable AND ai_config.ai_enable",
        "AI 只读不写：推荐 / 解析结果由用户确认后手动提交"
      ]
    },
    {
      "dot": "rose",
      "title": "使用登记口径",
      "items": [
        "use_status：1 正常 / 2 部分使用（实际人数少于预约人数）/ 3 失约（实际人数为 0）"
      ]
    }
  ]
}